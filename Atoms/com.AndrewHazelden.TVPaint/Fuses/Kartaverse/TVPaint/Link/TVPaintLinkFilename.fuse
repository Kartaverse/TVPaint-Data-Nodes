-- ============================================================================
-- constants
-- ============================================================================
FUSE_NAME = "TVPaintLinkFilename"
DATATYPE = "Text"

-- ============================================================================
-- fuse
-- ============================================================================
FuRegisterClass(FUSE_NAME, CT_Tool, {
	REGID_DataType = DATATYPE,
	REGID_InputDataType = DATATYPE,
	REG_NoCommonCtrls = true,
	REGS_Category = "TVPaint\\Link",
	REGS_Name = FUSE_NAME,
	REGS_OpDescription = "Returns the link image filename",
	REGS_OpIconString = FUSE_NAME,
	REGS_IconID = "Icons.Tools.Icons.TextPlus",
})

function Create()
	-- [[ Creates the user interface. ]]
	InScriptVal = self:AddInput("ScriptVal", "ScriptVal", {
		LINKID_DataType = "ScriptVal",
		LINK_Main = 1
	})
	InLayer = self:AddInput("Layer", "Layer", {
		LINKID_DataType = "Number",
		-- INPID_InputControl = "SliderControl",
		INPID_InputControl = "ScrewControl",
		INP_Default = 1,
		INP_Integer = true,
		INP_MinScale = 1,
		INP_MaxScale = 16,
		INP_MinAllowed = 1,
		INP_MaxAllowed = 1e+38,
		-- INP_MaxAllowed = 1000000,
		LINK_Main = 2
	})
	self:BeginControlNest("Image Asset", "Image Asset", true, {})
		InAssetMode = self:AddInput("Asset Mode", "AssetMode", {
			LINKID_DataType = "Number",
			INPID_InputControl = "MultiButtonControl",
			-- MBTNC_ForceButtons = true,
			--MBTNC_StretchToFit = true,
			INP_Default = 0,
			{MBTNC_AddButton = "Image ID"},
			{MBTNC_AddButton = "IFL"},
			INP_DoNotifyChanged = true,
		})
		InIndex = self:AddInput("Image ID", "Index", {
			LINKID_DataType = "Number",
			INPID_InputControl = "ScrewControl",
			-- INPID_InputControl = "SliderControl",
			INP_Default = 1,
			INP_Integer = true,
			INP_MinScale = 1,
			INP_MaxScale = 1000,
			INP_MinAllowed = 1,
			INP_MaxAllowed = 1e+38,
			-- INP_MaxAllowed = 1000000,
			LINK_Main = 3
		})
	self:EndControlNest()
	InShowInput = self:AddInput("Show Input", "ShowInput", {
		LINKID_DataType = "Number",
		INPID_InputControl = "CheckboxControl",
		INP_Integer = true,
		INP_Default = 1.0,
		INP_External = false,
		INP_DoNotifyChanged = true
	})
	OutText = self:AddOutput("Output" , "Output" , {
		LINKID_DataType = "Text",
		LINK_Main = 1
	})
end


function NotifyChanged(inp, param, time)
	--[[
		Handles all input control events.

		:param inp: Input that triggered a signal.
		:type inp: Input

		:param param: Parameter object holding the (new) value.
		:type param: Parameter

		:param time: Current frame number.
		:type time: float
	]]
	if inp == InShowInput then
		local visible
		if param.Value == 1.0 then visible = true else visible = false end

		InLayer:SetAttrs({LINK_Visible = visible})
		InIndex:SetAttrs({LINK_Visible = visible})
	elseif inp == InAssetMode then
		if param.Value == 0.0 then
			-- Image ID
			InIndex:SetAttrs({IC_Visible = true})
		else
			-- IFL
			InIndex:SetAttrs({IC_Visible = false})
		end
	end
end

function get(t, key)
	--[[
		Returns the value of a key in a table.

		:param t: Table to get key value for.
		:type t: table

		:param key: Key to get value of.
		:type key: string

		:rtype: ?
	]]
	local value = nil
	local found = false

	for k, v in pairs(t) do
		if k == key then
			value = v
			found = true
			break
		end
	end

	if not found then
		error(string.format("no key '%s' found in ScriptVal table", key))
	end

	return value
end

function Process(req)
	-- [[ Creates the output. ]]
	local tbl = InScriptVal:GetValue(req):GetValue()
	local key = InLayer:GetValue(req).Value

	-- Read the layer name
	local value_str = ""
	local num = 0

	local idx = InIndex:GetValue(req).Value
	local mode = InAssetMode:GetValue(req).Value
	if mode == 0 then
		-- Image ID
		-- Extract the number of clip layers
		if type(tbl) == "table" and tbl.project and tbl.project and tbl.project.clip and tbl.project.clip.layers and type(tbl.project.clip.layers) == "table" then
			-- Clamp the layer index at the maximum range
			max_keys = tonumber(table.getn(tbl.project.clip.layers))
			if key > max_keys then
				key = max_keys
			end

			-- Extract the layer number element
			groupLayerTbl = get(tbl.project.clip.layers, key)
			if type(groupLayerTbl) == "table" and groupLayerTbl.link then
				local link = groupLayerTbl.link
				-- Clamp the link index at the maximum range
				max_link = tonumber(table.getn(groupLayerTbl.link))
				if idx > max_link then
					idx = max_link
				end
	
				-- Extract the link number element
				groupLinkTbl = get(link, idx)
				if type(groupLinkTbl) == "table" and groupLinkTbl.file then
					value_str = groupLinkTbl.file
				end
			end
		end
	else
		-- IFL Sequence
		-- Extract the number of clip layers
		if type(tbl) == "table" and tbl.project and tbl.project and tbl.project.clip and tbl.project.clip.layers and type(tbl.project.clip.layers) == "table" then
			-- Clamp the layer index at the maximum range
			max_keys = tonumber(table.getn(tbl.project.clip.layers))
			if key > max_keys then
				key = max_keys
			end

			-- Extract the layer number element
			groupLayerTbl = get(tbl.project.clip.layers, key)
			if type(groupLayerTbl) == "table" and groupLayerTbl.link then
				local link = groupLayerTbl.link
				-- Clamp the link index at the maximum range
				max_link = tonumber(table.getn(groupLayerTbl.link))
				for i = 1, max_link do 
					-- Extract the link number element
					groupLinkTbl = get(link, i)
					if type(groupLinkTbl) == "table" and groupLinkTbl.file then
						-- Append the filename to the IFL list
						value_str = value_str .. tostring(groupLinkTbl.file) .. "\n"
					end
				end
			end
		end
	end

	local out = Text(value_str)
	OutText:Set(req, out)
end

