-- ============================================================================
-- constants
-- ============================================================================
FUSE_NAME = "TVPaintBackground"
DATATYPE = "Image"

-- ============================================================================
-- fuse
-- ============================================================================
FuRegisterClass(FUSE_NAME, CT_Tool, {
    REGID_DataType = DATATYPE,
    REGID_InputDataType = DATATYPE,
    REG_NoCommonCtrls = true,
    REGS_Category = "TVPaint\\Create",
    REGS_Name = FUSE_NAME,
    REGS_OpDescription = "Creates a background from the TVPaint camera resolution settings",
    REGS_OpIconString = FUSE_NAME,
    -- Should the current time setting be cached?
    REG_TimeVariant = false,
    REG_Unpredictable = false,
    REGS_IconID = "Icons.Tools.Icons.PseudoColor",
})


function Create()
    -- [[ Creates the user interface. ]]
    InScriptVal = self:AddInput("ScriptVal", "ScriptVal", {
        LINKID_DataType = "ScriptVal",
        LINK_Main = 1
    })
    self:RemoveControlPage("Controls")
    self:AddControlPage("Color", {CTID_DIB_ID = "Icons.Tools.Tabs.Color"})
    InR = self:AddInput("Red", "Red", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        LINKS_Name = "Color",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default  = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 0,
        INP_SendRequest = false,
        INP_Required = false,
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
    })
    InG = self:AddInput("Green", "Green", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default  = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 1,
        INP_SendRequest = false,
        INP_Required = false,
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
    })
    InB = self:AddInput("Blue", "Blue", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default  = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 2,
        INP_SendRequest = false,
        INP_Required = false,
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
    })
    InA = self:AddInput("Alpha", "Alpha", {
        LINKID_DataType = "Number",
        INPID_InputControl = "ColorControl",
        INP_MinScale = 0.0,
        INP_MaxScale = 1.0,
        INP_Default  = 1.0,
        IC_ControlGroup = 1,
        IC_ControlID = 3,
        INP_SendRequest = false,
        INP_Required = false,
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
    })
    self:AddControlPage("Image", {CTID_DIB_ID  = "Icons.Tools.Tabs.Image"})
    InWidth = self:AddInput("Width", "Width", {
        LINKID_DataType = "Number",
        INP_SendRequest = false,
        INP_Required = false,
        INPID_InputControl = "SliderControl",
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
        INP_Integer = true,
    })
    InHeight = self:AddInput("Height", "Height", {
        LINKID_DataType = "Number",
        INP_SendRequest = false,
        INP_Required = false,
        INPID_InputControl = "SliderControl",
        INP_DelayDefault = true,
        LINK_ForceSave = true,
        INP_Passive = true,
        INP_Integer = true,
    })
    OutImage = self:AddOutput("Output", "Output", {
        LINKID_DataType = "Image",
        LINK_Main = 1,
    })
end

function NotifyChanged(inp, param, time)
    --[[
        Handles all input control events.

        :param inp: Input that triggered a signal.
        :type inp: Input

        :param param: Parameter object holding the (new) value.
        :type param: Parameter

        :param time: Current frame number.
        :type time: float
    ]]
end

function Process(req)
    local tbl = InScriptVal:GetValue(req):GetValue()

    -- Image Size
    local width = 0
    local height = 0

    -- Extract the camera resolution
--    if type(tbl) == "table" and tbl.project and tbl.project and tbl.project.camera and type(tbl.project.camera) == "table"  then
--        width = tonumber(tbl.project.camera.width)
--        height = tonumber(tbl.project.camera.height)
--    end
    if type(tbl) == "table" and tbl.project and tbl.project and tbl.project.clip and type(tbl.project.clip) == "table" and tbl.project.clip.width and tbl.project.clip.height then
        width = tonumber(tbl.project.clip.width)
        height = tonumber(tbl.project.clip.height)
    end

    InWidth:SetSource(Number(width), 0)
    InWidth:SetAttrs({INP_Default = width})

    InHeight:SetSource(Number(height), 0)
    InHeight:SetAttrs({INP_Default = height})

    local r = 0
    local g = 0
    local b = 0
    local a = 1

    -- Extract the color
    if type(tbl) == "table" and tbl.project and tbl.project and tbl.project.clip and type(tbl.project.clip) == "table" and tbl.project.clip.bg and type(tbl.project.clip.bg) == "table" then
        r = tbl.project.clip.bg.red * (1 / 255)
        g = tbl.project.clip.bg.green * (1 / 255)
        b = tbl.project.clip.bg.blue * (1 / 255)
    end

    -- Color
    local rgba = Pixel({R = r, G = g, B = b, A = a})

    InR:SetSource(Number(r), 0)
    InR:SetAttrs({INP_Default = r})

    InG:SetSource(Number(g), 0)
    InG:SetAttrs({INP_Default = g})

    InB:SetSource(Number(b), 0)
    InB:SetAttrs({INP_Default = b})

    InA:SetSource(Number(a), 0)
    InA:SetAttrs({INP_Default = a})

    -- Create image context
    local out = Image({
        IMG_Width = width,
        IMG_Height = height,
        IMG_NoData = req:IsPreCalc(),
        IMG_Depth = IMDP_128bitFloat,
    })
    out:Fill(rgba)

    OutImage:Set(req, out)
end
