--[[--
==============================================================================
TVPaint for Fusion - v1 2025-11-17
==============================================================================
--]]--
{
	Action
	{
		ID = "TVPaint_Comp_Builder",
		Category = "TVPaint",
		Name = "Comp Builder...",

		Targets =
		{
			Composition =
			{
				Execute = _Lua [=[
local scriptPath = app:MapPath("Scripts:/Comp/TVPaint/TVPaint Comp Builder.lua")
target:RunScript(scriptPath)
				]=],
			},
		},
	},
	Action
	{
		ID = "TVPaint_About",
		Category = "TVPaint",
		Name = "About TVPaint for Fusion",

		Targets =
		{
			Composition =
			{
				Execute = _Lua [=[
local scriptPath = app:MapPath("Scripts:/Comp/TVPaint/About TVPaint for Fusion.lua")
target:RunScript(scriptPath)
				]=],
			},
		},
	},
	Hotkeys
	{
		Target = "FlowView",

		SHIFT_B = "TVPaint_Comp_Builder{}",
		SHIFT_DELETE = "RunScript{filename = 'Scripts:/Comp/TVPaint/Remove Unselected Nodes.lua'}",
		SHIFT_BACKSPACE = "RunScript{filename = 'Scripts:/Comp/TVPaint/Remove Unselected Nodes.lua'}",
	},
	Menus
	{
		Target = "ChildFrame",

		Before "Help"
		{
			Sub "TVPaint"
			{
				"TVPaint_Comp_Builder{}",
				"_",
				"TVPaint_About{}",
			},
		},
	},
}
